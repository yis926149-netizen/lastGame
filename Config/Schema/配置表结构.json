        { "name": "weight", "type": "int", "required": true, "min": 1, "note": "抽取权重（当前纯随机，均为1）" },
        { "name": "enabled", "type": "bool", "required": true, "note": "是否可抽取" },
        { "name": "guaranteedFirst", "type": "bool", "required": true, "note": "是否为首张保底卡" }
