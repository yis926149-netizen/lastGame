    {
      "sheetName": "建筑",
      "key": "buildingId",
      "description": "建筑 HP、类型、阻挡、卡费、产出单位与金矿收入。已录入当前 7 个建筑真实迁移值。出兵间隔与箭塔攻击参数当前硬编码于组件，属缺口，待阶段2 补齐。",
      "columns": [
        { "name": "buildingId", "type": "string", "required": true, "unique": true,
          "idPattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$", "note": "稳定ID，如 building.gold_mine" },
        { "name": "legacyId", "type": "int", "required": true, "min": 0, "note": "迁移期旧整数ID（buildingId）" },
        { "name": "displayName", "type": "string", "required": true, "note": "显示名称" },
        { "name": "buildingType", "type": "enum", "required": true,
          "enum": ["AttackStatue", "DefenseStatue", "Altar", "TechnologyAndCultural", "Barracks", "ArrowTower", "GoldMine"],
          "note": "建筑类型（对应 Enums.BulidingType）" },
        { "name": "hp", "type": "float", "required": true, "min": 0, "minExclusive": true, "note": "基础血量" },
        { "name": "blocksMovement", "type": "bool", "required": true, "note": "是否阻挡移动" },
        { "name": "cardCost", "type": "int", "required": true, "min": 0, "note": "卡费" },
        { "name": "producedUnitId", "type": "string", "required": false,
