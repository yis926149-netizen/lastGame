        { "name": "unitId", "type": "string", "required": true, "unique": true,
          "idPattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$", "note": "稳定ID，如 unit.archer" },
        { "name": "legacyId", "type": "int", "required": true, "min": 0,
          "note": "迁移期旧整数ID，完成迁移后移除" },
        { "name": "displayName", "type": "string", "required": true, "note": "显示名称，不作为关联键" },
        { "name": "enabled", "type": "bool", "required": true, "note": "启用状态" },
        { "name": "strategyType", "type": "enum", "required": true,
          "enum": ["Melee", "Ranged", "Settler"], "note": "兵种策略类型" },
        { "name": "hp", "type": "float", "required": true, "min": 0, "minExclusive": true, "note": "生命值" },
        { "name": "attack", "type": "float", "required": true, "min": 0, "note": "攻击力" },
        { "name": "defense", "type": "float", "required": true, "min": 0, "note": "防御力" },
        { "name": "attackRange", "type": "int", "required": true, "min": 0, "note": "攻击射程（格）" },
        { "name": "movementPoints", "type": "float", "required": true, "min": 0, "minExclusive": true, "note": "移动力" },
        { "name": "viewPoints", "type": "int", "required": true, "min": 0, "note": "视野" },
        { "name": "attackIntervalSeconds", "type": "float", "required": true, "min": 0,
          "note": "攻击间隔（秒），非移民必须大于0" },
        { "name": "cardCost", "type": "int", "required": true, "min": 0, "note": "卡费" }
      ],
      "rules": [
        {
          "id": "attackInterval-positive",
          "type": "conditionalMinExclusive",
          "field": "attackIntervalSeconds",
          "whenField": "strategyType",
          "whenNotIn": ["Settler"],
          "min": 0,
          "description": "非移民单位攻击间隔必须大于0"
